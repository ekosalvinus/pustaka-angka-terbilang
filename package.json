{
  "name": "pustaka-angka-terbilang",
  "version": "1.0.0",
  "description": "Angka terbilang bahasa Indonesia: rupiah & mata uang ASEAN, format ringkas (Rb/Jt/M/T), persen, bilangan tingkat, tanggal legal. Zero dependency, ESM, TypeScript, adapter Vue.",
  "keywords": [
    "terbilang",
    "angka",
    "rupiah",
    "indonesia",
    "kwitansi",
    "number-to-words",
    "vue",
    "nuxt"
  ],
  "license": "MIT",
  "author": "Eko Salvinus",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/ekosalvinus/pustaka-angka-terbilang.git"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && node scripts/fix-dts.mjs",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vue": "^3.5.0"
  }
}
